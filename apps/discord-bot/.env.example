# Discord bot token from the application's Bot page.
DISCORD_TOKEN=

# Comma-separated Discord user ids. DMs and channel messages from anyone else
# are ignored silently.
DISCORD_ALLOWED_USER_IDS=

# One machine. The T3 Code environment's MCP endpoint, for example
# http://127.0.0.1:3773/mcp, and a bearer token minted once with
# `npm run mint-token` for that machine.
# Set this pair, or T3_ENVIRONMENTS below, never both.
T3_MCP_URL=
T3_MCP_TOKEN=

# Several machines, as a JSON array. `label` is the machine name people see in
# /tot list, /tot use and channel names; it needs its own token from that
# machine. Example:
# T3_ENVIRONMENTS=[{"label":"laptop","mcpUrl":"http://127.0.0.1:3773/mcp","token":"..."},{"label":"office","mcpUrl":"https://office.tailnet.ts.net/mcp","token":"..."}]
T3_ENVIRONMENTS=

# Optional: a server id. With it, the bot gives every Tot a text channel named
# tot-<totId> (tot-<label>-<totId> when two machines share an id) with its own
# webhook. Needs the Message Content intent and the permissions in the runbook.
DISCORD_GUILD_ID=

# Optional: pin channels that already exist to a Tot, as channelId=totId or
# channelId=label:totId pairs separated by commas or spaces. Needs
# DISCORD_GUILD_ID.
CHANNEL_TOT_MAP=

# Optional: where rendered Tot faces and webhook ids are cached. Default
# .webhook-avatars/<machine>.
DISCORD_AVATAR_DIR=
