# Discord bot token from the application's Bot page.
DISCORD_TOKEN=

# Comma-separated Discord user ids. DMs from anyone else are ignored silently.
DISCORD_ALLOWED_USER_IDS=

# The T3 Code environment's MCP endpoint, for example http://127.0.0.1:3773/mcp.
T3_MCP_URL=

# Bearer token for that endpoint, minted once with `npm run mint-token`.
T3_MCP_TOKEN=
