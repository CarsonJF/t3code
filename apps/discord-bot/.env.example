# Discord bot token from the application's Bot page.
DISCORD_TOKEN=

# Comma-separated Discord user ids. DMs and channel messages from anyone else
# are ignored silently.
DISCORD_ALLOWED_USER_IDS=

# The T3 Code environment's MCP endpoint, for example http://127.0.0.1:3773/mcp.
T3_MCP_URL=

# Bearer token for that endpoint, minted once with `npm run mint-token`.
T3_MCP_TOKEN=

# Optional: a server id. With it, the bot gives every Tot a text channel named
# tot-<totId> with its own webhook. Needs the Message Content intent and the
# permissions in the runbook.
DISCORD_GUILD_ID=

# Optional: pin channels that already exist to a Tot, as channelId=totId pairs
# separated by commas or spaces. Needs DISCORD_GUILD_ID.
CHANNEL_TOT_MAP=

# Optional: where rendered Tot faces and webhook ids are cached. Default
# .webhook-avatars/<environment>.
DISCORD_AVATAR_DIR=
